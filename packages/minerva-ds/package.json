{
  "name": "@judi-health/minerva-ds",
  "version": "0.3.0",
  "description": "Minerva design system: React components, tokens, and themes for Judi prototypes.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns.js"
    },
    "./document-viewer": {
      "types": "./dist/patterns/DocumentViewer/index.d.ts",
      "import": "./dist/document-viewer.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./guidelines/*": "./guidelines/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "guidelines",
    "ATTRIBUTIONS.md"
  ],
  "scripts": {
    "generate:tokens": "tsx src/tokens/buildCss.ts",
    "build": "npm run generate:tokens && npm run build:js && npm run build:css",
    "build:js": "vite build",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css && tailwindcss -i src/styles/tokens.css -o dist/tokens.css",
    "typecheck": "tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@embedpdf/react-pdf-viewer": "^2.15.1"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vite-plugin-dts": "^5.0.0"
  }
}
